<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constLay_item_setting"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <Space
        android:layout_width="@dimen/itemDividerHorizontalSpacing"
        android:layout_height="match_parent"/>

    <ImageView
        android:id="@+id/img_setting_icon"
        android:layout_width="@dimen/itemSetting_itemSelectionFlag_sImg"
        android:layout_height="@dimen/itemSetting_itemSelectionFlag_sImg"
        android:contentDescription="@string/app_icon"
        app:srcCompat="@drawable/setting_app_theme_icon" />

    <Space
        android:layout_width="@dimen/itemDividerHorizontalSpacingBetweenContent"
        android:layout_height="match_parent"/>

    <TextView
        android:id="@+id/tv_setting_item_title"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        style="@style/TextViewStyle.regular"
        android:textSize="@dimen/dialog_TextSize_4"
        android:gravity="center_vertical"
        android:singleLine="true"
        android:text="@string/app_name"
         />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/img_setting_moveArrow_icon"
            android:layout_width="@dimen/itemSetting_itemSelectionIconSize_1"
            android:layout_height="@dimen/itemSetting_itemSelectionIconSize_1"
            android:contentDescription="@string/app_icon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:srcCompat="@drawable/setting_move_arrow_icon" />

        <TextView
            android:id="@+id/tv_setting_item_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/TextViewStyle.regular"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:text="@string/app_name"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/itemCountry_nameTextSize_2"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

    <Space
        android:layout_width="@dimen/itemDividerHorizontalSpacing"
        android:layout_height="match_parent"/>

</LinearLayout>
