<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/itemLanguage_Height"
    android:paddingVertical="@dimen/itemLanguageVerticalSpacing"
    android:background="@drawable/item_background">

    <LinearLayout
        android:id="@+id/ll_first"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Space
            android:layout_width="@dimen/itemLanguageHorizontalSpacing"
            android:layout_height="match_parent"/>

        <TextView
            android:id="@+id/itemSelectionFlag_text"
            android:layout_width="@dimen/itemLanguage_itemSelectionFlag_sImg"
            android:layout_height="@dimen/itemLanguage_itemSelectionFlag_sImg"
            android:contentDescription="country flag"
            style="@style/TextViewStyle.medium"
            android:textSize="@dimen/itemLanguage_nameTextSize_1"
            android:textColor="@color/white"
            android:gravity="center"
            android:textAlignment="center"
            android:text="HI"
            android:textAllCaps="true"
            android:background="@drawable/ic_language_flag"
            tools:ignore="HardcodedText" />

        <Space
            android:layout_width="@dimen/itemLanguageHorizontalSpacingBetweenContent"
            android:layout_height="match_parent"/>

        <TextView
            android:id="@+id/itemSelection_text"
            style="@style/TextViewStyle.regular"
            android:textSize="@dimen/itemLanguage_nameTextSize_2"
            android:layout_gravity="center"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:text="@string/language_header"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/itemSelection_text_icon"
            android:layout_width="@dimen/itemLanguage_itemSelectionIconSize_1"
            android:layout_height="@dimen/itemLanguage_itemSelectionIconSize_1"
            android:layout_gravity="end|center_vertical"
            android:src="@drawable/icon_unchecked"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:contentDescription="@string/check_icon" />

        <Space
            android:layout_width="@dimen/itemLanguageHorizontalSpacing"
            android:layout_height="match_parent"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>