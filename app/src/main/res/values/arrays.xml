<resources>

    <!-- week day full or short -->
    <string-array name="week_1">
        <item>@string/mon</item>
        <item>@string/tue</item>
        <item>@string/wed</item>
        <item>@string/thu</item>
        <item>@string/fri</item>
        <item>@string/sat</item>
        <item>@string/sun</item>
    </string-array>
    <string-array name="week_2">
        <item>@string/sun</item>
        <item>@string/mon</item>
        <item>@string/tue</item>
        <item>@string/wed</item>
        <item>@string/thu</item>
        <item>@string/fri</item>
        <item>@string/sat</item>
    </string-array>
    <string-array name="week_3">
        <item>@string/sat</item>
        <item>@string/sun</item>
        <item>@string/mon</item>
        <item>@string/tue</item>
        <item>@string/wed</item>
        <item>@string/thu</item>
        <item>@string/fri</item>
    </string-array>
    <string-array name="short_week_1">
        <item>@string/short_mon</item>
        <item>@string/short_tue</item>
        <item>@string/short_wed</item>
        <item>@string/short_thu</item>
        <item>@string/short_fri</item>
        <item>@string/short_sat</item>
        <item>@string/short_sun</item>
    </string-array>
    <string-array name="short_week_2">
        <item>@string/short_sun</item>
        <item>@string/short_mon</item>
        <item>@string/short_tue</item>
        <item>@string/short_wed</item>
        <item>@string/short_thu</item>
        <item>@string/short_fri</item>
        <item>@string/short_sat</item>
    </string-array>
    <string-array name="short_week_3">
        <item>@string/short_sat</item>
        <item>@string/short_sun</item>
        <item>@string/short_mon</item>
        <item>@string/short_tue</item>
        <item>@string/short_wed</item>
        <item>@string/short_thu</item>
        <item>@string/short_fri</item>
    </string-array>

    <!-- RepeatOption -->
    <string-array name="repeat_options">
        <item>@string/never</item>
        <item>@string/every_day</item>
        <item>@string/every_week</item>
        <item>@string/every_month</item>
        <item>@string/every_year</item>
    </string-array>
    <!-- AlertOption -->
    <string-array name="alert_offset_options">
        <item>@string/none</item>
        <item>@string/at_time</item>
        <item>@string/before_5_minutes</item>
        <item>@string/before_10_minutes</item>
        <item>@string/before_15_minutes</item>
        <item>@string/before_30_minutes</item>
        <item>@string/before_1_hour</item>
        <item>@string/before_1_day</item>
        <item>@string/before_custom_time</item>
    </string-array>

</resources>
